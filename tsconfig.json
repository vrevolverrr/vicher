{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "lib": ["DOM", "ES2023"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts", "bench/**/*.ts", "bench/**/*.mts", "eval/**/*.ts", "eval/**/*.mts"]
}
