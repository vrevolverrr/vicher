{
  "name": "vicher",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Chat with Claude Code or Codex beside your notes. Highlight and scroll to parts of the note, quote text into the chat, and get native visuals, using your own subscription or BYOK.",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:live": "tsx --test tests/live/agents.test.ts",
    "test:vault": "tsx --test tests/vault/layout.test.ts",
    "bench": "tsx bench/latency/bench.ts",
    "bench:figures": "tsx bench/figure/run.mts",
    "eval:figures": "tsx eval/figure/run.mts",
    "eval": "tsx eval/run.mts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.306",
    "@lezer/markdown": "1.7.2",
    "cross-spawn": "7.0.6",
    "sucrase": "3.35.0",
    "tslib": "^2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.1",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.13.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-svelte": "^3.24.0",
    "jsdom": "^30.1.3",
    "obsidian": "1.14.4",
    "pele": "1.9.0",
    "promptfoo": "^0.125.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
